<?xml version="1.0"?>
<odoo>
	<record id="estate_property_view_search" model="ir.ui.view">
		<field name="name">estate.property.search</field>
		<field name="model">estate.property</field>
		<field name="arch" type="xml">
			<search string="Properties">
				<field name="name"/>
				<field name="postcode"/>
				<field name="expected_price"/>
				<field name="bedroom_count"/>
				<field name="living_area_sqm_rounded"/>
				<field name="facade_count"/>
				<field name="state"/>
				<filter string="Available Properties" name="available_properties" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
				<group>
					<filter string="Postcode Grouping" name="postcode_grouping" context="{'group_by':'postcode'}"/>
				</group>
			</search>
		</field>
	</record>
</odoo>