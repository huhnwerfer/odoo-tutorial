<?xml version="1.0"?>
<odoo>
	<record id="estate_property_view_form" model="ir.ui.view">
		<field name="name">estate.property.form</field>
		<field name="model">estate.property</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" nolabel="1" placeholder="Property name"/>
						</h1>
					</div>

					<group>
						<group>
							<field name="postcode"/>
							<field name="availability_date"/>
						</group>
						<group>
							<field name="expected_price"/>
							<field name="selling_price" readonly="1"/>
						</group>
					</group>
					<notebook>
						<page string="Description">
							<group>
								<field name="description"/>
								<field name="bedroom_count"/>
								<field name="living_area_sqm_rounded"/>
								<field name="facade_count"/>
								<field name="has_garage"/>
								<field name="has_garden"/>
								<field name="garden_area_sqm_rounded"/>
								<field name="garden_orientation"/>
							</group>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>
</odoo>