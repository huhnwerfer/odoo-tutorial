<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="stock_delivery_inherit" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-set='backorders']" positions="replace">
            <t t-set="backorders" t-value="o.move_ids.refrence_ids.picking_ids.filtered(lambda x: x.state not in ('done', 'cancel') and x.backorder_id)"/>
        </xpath>
        <xpath expr="//div[@t-if='not (o.backorder_ids and backorders)']" position="replace">
            <div t-if="not backorders" class="oe_structure"/>
        </xpath>
    </template>
</odoo>